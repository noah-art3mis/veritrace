ANTHROPIC_API_KEY=''
EXA_API_KEY=''
GOOGLE_FACT_CHECK_API_KEY=''

# Reasoning backend (ADR 0004). Default is Anthropic. To run without Anthropic credits, set
# LLM_PROVIDER to an OpenAI-compatible backend and supply its key. The gather loop needs a
# tool-use-capable model.
#   LLM_PROVIDER=gemini            # gemini | openai-compatible | openai | anthropic (default)
#   GEMINI_API_KEY=''              # used when LLM_PROVIDER routes to the OpenAI-compatible adapter
# Optional overrides for the OpenAI-compatible adapter (defaults target Gemini):
#   OPENAI_COMPAT_BASE_URL=''      # default https://generativelanguage.googleapis.com/v1beta/openai/
#   OPENAI_COMPAT_MODEL=''         # default gemini-2.5-flash-lite (cheapest tier; override for a stronger model)
#   OPENAI_COMPAT_API_KEY=''       # alternative to GEMINI_API_KEY (e.g. a Groq/OpenRouter key)
#   OPENAI_API_KEY=''              # also accepted as the OpenAI-compatible key (lowest precedence)
