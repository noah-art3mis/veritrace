ANTHROPIC_API_KEY=''
EXA_API_KEY=''
GOOGLE_FACT_CHECK_API_KEY=''
GEMINI_API_KEY=''
OPENAI_API_KEY=''

# Reasoning backend (ADR 0004) is chosen by the MODEL picked in the UI — there is no separate
# provider switch. Each model in the registry (lib/run-config.ts) carries its provider + endpoint:
#   claude-*  -> Anthropic        (ANTHROPIC_API_KEY)
#   gemini-*  -> Gemini OpenAI-compat endpoint   (GEMINI_API_KEY)
#   gpt-*     -> OpenAI           (OPENAI_API_KEY)
# Set the key(s) for whichever model(s) you select. Default model: gemini-2.5-flash-lite.
#
# Generic overrides for a custom OpenAI-compatible backend (Groq / OpenRouter / a local server):
#   OPENAI_COMPAT_BASE_URL=''      # overrides the selected model's endpoint
#   OPENAI_COMPAT_API_KEY=''       # universal key override (takes precedence over the per-model key)
